generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Outlet {
  id         String   @id @default(cuid())
  name       String
  phone      String
  address    String
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true)
  openTime   String?
  closeTime  String?
  closedNote String?
  createdAt  DateTime @default(now())

  users         User[]
  menus         Menu[]
  conversations Conversation[]
  orders        Order[]
  payment       OutletPayment?
  ratings       OutletRating[]
  reservations  Reservation[]
}

model OutletRating {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  buyerName String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
}

model Reservation {
  id          String   @id @default(cuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  buyerId     String?
  buyerName   String
  buyerPhone  String
  partySize   Int
  reservedFor DateTime
  notes       String?
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String // OWNER | CASHIER
  outletId  String?
  outlet    Outlet?  @relation(fields: [outletId], references: [id])
  createdAt DateTime @default(now())

  orders Order[]
}

model Buyer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  password  String?
  address   String?
  points    Int      @default(0)
  createdAt DateTime @default(now())

  conversations     Conversation[]
  orders            Order[]
  pointTransactions PointTransaction[]
}

model PointTransaction {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  orderId   String?
  delta     Int
  reason    String
  createdAt DateTime @default(now())
}

model SiteSetting {
  id                String   @id @default("singleton")
  announcement      String?
  isActive          Boolean  @default(false)
  themeName         String   @default("default")
  pointsEarnPercent Float    @default(1)

  // Hero banner on the landing page — owner-managed from the CMS,
  // typically to announce a new menu item.
  bannerActive   Boolean @default(false)
  bannerImage    String? // data URL, same convention as Menu.image / OutletPayment.qrisImage
  bannerTag      String? // small eyebrow label, e.g. "MENU BARU"
  bannerTitle    String?
  bannerSubtitle String?
  bannerCtaText  String?
  bannerCtaHref  String?

  updatedAt DateTime @updatedAt
}

model OutletPayment {
  id        String   @id @default(cuid())
  outletId  String   @unique
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  qrisImage String? // path/base64
  ownerName String
  notes     String?
  updatedAt DateTime @updatedAt
}

model Menu {
  id          String   @id @default(cuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name        String
  category    String
  description String?
  price       Int
  image       String?
  isAvailable Boolean  @default(true)
  isPromo     Boolean  @default(false)
  promoPrice  Int?
  createdAt   DateTime @default(now())

  orderItems   OrderItem[]
  optionGroups MenuOptionGroup[]
}

model MenuOptionGroup {
  id       String  @id @default(cuid())
  menuId   String
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name     String
  required Boolean @default(false)
  multiple Boolean @default(false)

  options MenuOption[]
}

model MenuOption {
  id         String          @id @default(cuid())
  groupId    String
  group      MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Int             @default(0)
}

model Conversation {
  id          String   @id @default(cuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  buyerId     String?
  buyer       Buyer?   @relation(fields: [buyerId], references: [id])
  buyerName   String
  buyerPhone  String
  status      String   @default("OPEN") // OPEN | WAITING | CLOSED
  lastMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[]
  orders   Order[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String // buyer | cashier | system
  type           String   @default("text") // text | image | system
  content        String
  createdAt      DateTime @default(now())
}

model Order {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  outletId       String
  outlet         Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  cashierId      String?
  cashier        User?    @relation(fields: [cashierId], references: [id])
  buyerId        String?
  buyer          Buyer?   @relation(fields: [buyerId], references: [id])

  buyerName  String
  buyerPhone String

  orderType       String    @default("TAKEAWAY") // TAKEAWAY | DELIVERY
  deliveryAddress String?
  latitude        Float?
  longitude       Float?
  scheduledFor    DateTime?
  queueNumber     Int?

  subtotal    Int @default(0)
  discount    Int @default(0)
  tax         Int @default(0)
  deliveryFee Int @default(0)
  pointsUsed  Int @default(0)
  total       Int @default(0)

  status String @default("DRAFT")
  // DRAFT | WAITING_CONFIRMATION | WAITING_PAYMENT | WAITING_PAYMENT_VERIFICATION
  // | PAID | QUEUED | COOKING | READY | COMPLETED | CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  payment Payment?
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuId   String?
  menu     Menu?   @relation(fields: [menuId], references: [id])
  menuName String
  qty      Int
  price    Int
  subtotal Int
  notes    String?
  forName  String?

  options OrderItemOption[]
}

model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionName  String
  priceDelta  Int
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method     String   @default("QRIS")
  amount     Int
  proofImage String?
  status     String   @default("UNPAID") // UNPAID | WAITING_VERIFICATION | PAID | REJECTED
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
