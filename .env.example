# Salin ke .env lalu isi nilainya. JANGAN commit .env yang berisi nilai asli.

# SQLite lokal. Di server, arahkan ke path absolut yang persisten.
DATABASE_URL="file:./dev.db"

# Kunci penanda tangan sesi login (owner, kasir, pembeli).
# Bangkitkan yang acak: openssl rand -base64 48
JWT_SECRET="ganti-dengan-nilai-acak-yang-panjang"
